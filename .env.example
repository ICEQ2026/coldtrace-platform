# ColdTrace Platform local environment template.
# Copy this file to .env.local and replace placeholders with local/test values.

DATABASE_USER=root
DATABASE_PASSWORD=root
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200,https://coldtrace-frontend-liard.vercel.app,https://coldtrace-frontend-*.vercel.app

JWT_SECRET=ColdTraceDevelopmentJwtSecretKeyForHS256NeedsAtLeast32Bytes
JWT_EXPIRATION_DAYS=7

GOOGLE_OAUTH_CLIENT_ID=<google-web-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-web-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4200

APPLE_OAUTH_CLIENT_ID=<apple-services-id>
APPLE_OAUTH_REDIRECT_URI=https://coldtrace-frontend-liard.vercel.app/identity-access/sign-in
APPLE_TEAM_ID=<apple-team-id>
APPLE_KEY_ID=<apple-key-id>
APPLE_PRIVATE_KEY=<apple-private-key-p8-content-with-escaped-newlines>

AI_MODEL_PROVIDER=ollama
AI_MODEL_NAME=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
AI_REQUEST_TIMEOUT=120s
OPENAI_API_KEY=<openai-project-api-key-for-production-like-smoke-tests>

STRIPE_SECRET_KEY=<stripe-test-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-cli-or-dashboard-webhook-signing-secret>
STRIPE_OPERATIONS_PRICE_ID=<stripe-operations-recurring-price-id>
STRIPE_COMPLIANCE_AI_PRICE_ID=<stripe-compliance-ai-recurring-price-id>
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:4200/settings/billing?checkout=success&session_id={CHECKOUT_SESSION_ID}
BILLING_CHECKOUT_CANCEL_URL=http://localhost:4200/settings/billing?checkout=cancel
BILLING_CUSTOMER_PORTAL_RETURN_URL=http://localhost:4200/settings/billing?portal=return
