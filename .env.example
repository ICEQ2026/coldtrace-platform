# ColdTrace Platform local environment template.
# Copy this file to .env.local and fill provider-console values.
# .env.local is loaded by the dev profile and ignored by Git.

DATABASE_USER=root
DATABASE_PASSWORD=root
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200,http://127.0.0.1:4200

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4200

APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Use the p8 file contents, not the filesystem path. Keep it on one line with \n separators.
APPLE_PRIVATE_KEY=
